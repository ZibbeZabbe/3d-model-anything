{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts"
  },
  "mutate": [
    "packages/room-runtime/walls.ts"
  ],
  "coverageAnalysis": "perTest",
  "reporters": [
    "clear-text",
    "progress",
    "html"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "tempDirName": ".stryker-tmp",
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": null
  },
  "tsconfigFile": "stryker-no-tsconfig.json",
  "//": "TypeScript 7 has no JS API for Stryker tsconfig rewriting; Vitest transpiles itself, so point at a file that does not exist to skip that step."
}
